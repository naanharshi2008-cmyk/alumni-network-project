# Copy this file to .env.local and fill in the real values.
# In production these are set in Vercel -> Project Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Public (safe to ship to the browser — Next.js inlines anything NEXT_PUBLIC_*)
# Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used in the admin notification email's "open the dashboard" link.
NEXT_PUBLIC_SITE_URL=https://v-alumninetwork.vercel.app

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefix these with NEXT_PUBLIC_.
# The service role key bypasses row-level security completely: anyone holding
# it can read and delete every record, so it must never reach the browser.
# ---------------------------------------------------------------------------

# Needed for: deleting an alumni profile (row + photo + login account).
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Needed for: emailing an admin when someone registers. https://resend.com
# Leave blank and registration still works — the email is simply skipped.
RESEND_API_KEY=
ADMIN_EMAIL=
# Optional. Must be a Resend-verified sender; the default works for testing.
ADMIN_EMAIL_FROM=Veveaham Alumni <onboarding@resend.dev>
