# Copy this file to .env.local and fill in the real values.
# In production these are set in Vercel -> Project Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Public (safe to ship to the browser — Next.js inlines anything NEXT_PUBLIC_*)
# Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used in the admin notification email's "open the dashboard" link.
NEXT_PUBLIC_SITE_URL=https://v-alumninetwork.vercel.app

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefix these with NEXT_PUBLIC_.
# The service role key bypasses row-level security completely: anyone holding
# it can read and delete every record, so it must never reach the browser.
# ---------------------------------------------------------------------------

# Needed for: deleting an alumni profile (row + photo + login account).
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email. Two ways out; the site uses whichever is set (Workspace wins).
# Leave both blank and everything still works — the emails are simply skipped.
# ---------------------------------------------------------------------------

# PREFERRED: send as the school's own mailbox through Google Workspace. Needs
# no DNS record of any kind, and the same key lets the import read a Google
# Sheet shared with that mailbox.
#   1. Google Cloud console -> a project -> enable the Gmail API and the
#      Google Sheets API.
#   2. Create a service account, then a JSON key. Paste the WHOLE key here,
#      on one line.
#   3. Admin console -> Security -> Access and data control -> API controls ->
#      Domain-wide delegation -> Add new, with the service account's Client ID
#      and these scopes:
#        https://www.googleapis.com/auth/gmail.send,
#        https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_SERVICE_ACCOUNT_JSON=
# The mailbox it acts as (sends from, and reads sheets as).
GOOGLE_SHEETS_SUBJECT=alumni@dpmschools.com

# OR: send through Resend. Needs dpmschools.com verified there, which needs
# DNS records. https://resend.com
RESEND_API_KEY=
# Optional, to force one way out when both are set: workspace | resend
MAIL_TRANSPORT=

# Where new-registration alerts go.
ADMIN_EMAIL=
# The name and address mail appears to come from.
ADMIN_EMAIL_FROM=Veveaham Alumni <alumni@dpmschools.com>
